<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de conexión Bluetooth (solo diseño, sin lógica).
    Los datos son de ejemplo: en el prototipo real vendrían de los
    dispositivos emparejados del teléfono.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F1"
    android:fillViewport="true">

    <!-- ScrollView solo admite un hijo, por eso todo va dentro de este LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar al nodo sensor"
            android:textColor="#1B4332"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Módulo Bluetooth HC-05 del prototipo"
            android:textColor="#52796F"
            android:textSize="14sp" />

        <!-- ===== Tarjeta de estado =====
             Va primero porque es lo primero que el usuario necesita saber:
             si está conectado o no antes de intentar cualquier cosa. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Punto de estado: una mini tarjeta redonda evita crear un drawable extra -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:cardBackgroundColor="#B23A48"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado actual"
                        android:textColor="#52796F"
                        android:textSize="13sp" />

                    <!-- Rojo porque "sin conexión" es un estado que requiere acción -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin conexión"
                        android:textColor="#B23A48"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Lista de dispositivos emparejados ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Dispositivos emparejados"
            android:textColor="#1B4332"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Dispositivo 1: el nodo sensor real del prototipo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HC-05 (nodo sensor)"
                        android:textColor="#1B4332"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Monoespaciado: la dirección MAC se lee mejor con caracteres de ancho fijo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="98:D3:31:F5:A2:B1"
                        android:textColor="#52796F"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectarNodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2D9D5B"
                    android:text="Conectar"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dispositivo 2: otro HC-05; se muestra para dejar claro que hay que elegir el correcto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HC-05 (otro)"
                        android:textColor="#1B4332"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="98:D3:41:F6:0C:7E"
                        android:textColor="#52796F"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Botón con contorno: menos protagonismo que el del nodo sensor -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectarOtro"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conectar"
                    android:textColor="#2D9D5B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#2D9D5B" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dispositivo 3: desconocido; texto secundario para indicar que no es confiable -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dispositivo desconocido"
                        android:textColor="#52796F"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="00:1A:7D:DA:71:13"
                        android:textColor="#52796F"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectarDesconocido"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conectar"
                    android:textColor="#2D9D5B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#2D9D5B" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Tarjeta informativa de seguridad =====
             Se documenta la brecha del PIN por defecto (1234) a la vista,
             porque cualquiera cerca podría emparejarse con el HC-05. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1B2A24"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aviso de seguridad"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Monoespaciado, igual que la tarjeta oscura del main, porque menciona un comando AT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="El PIN por defecto 1234 debe cambiarse (AT+PSWD)"
                    android:textColor="#D8E8DE"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón principal al final: buscar es la acción si el nodo no aparece en la lista -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarDispositivos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#2D9D5B"
            android:text="Buscar dispositivos"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>